{
  "name": "@inkiebeard/speck",
  "version": "0.2.0",
  "description": "A tiny data-oriented game engine on top of Three.js & rapier3d",
  "license": "MIT",
  "type": "module",
  "main": "./dist/speck.js",
  "module": "./dist/speck.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/speck.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "email": "aaron@inkiebeard.codes",
    "name": "Aaron Toomey",
    "url": "https://inkiebeard.codes"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build && node scripts/write-speck-dts.mjs",
    "typecheck": "tsc --noEmit",
    "example": "npm run build && npx --yes serve .",
    "pretest": "npm run build",
    "test": "playwright test",
    "pretest:perf": "npm run build",
    "test:perf": "playwright test tests/perf",
    "pretest:noise": "npm run build",
    "test:noise": "playwright test tests/noise",
    "pretest:vector": "npm run build",
    "test:vector": "playwright test tests/vector tests/perf/vector.spec.ts tests/perf/quaternion.spec.ts",
    "pretest:spatial-grid": "npm run build",
    "test:spatial-grid": "playwright test tests/spatial-grid tests/perf/spatial-grid.spec.ts"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": ">=0.14.0",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
